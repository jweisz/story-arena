# Copy this file to .env and fill in the keys for the providers you use.
# Every variable is optional: local backends (Ollama, LM Studio) need no keys.

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama: only needed if Ollama isn't at the default http://localhost:11434
# OLLAMA_API_BASE=http://localhost:11434

# LM Studio: only needed for `lm_studio/...` models that don't set api_base in models.toml
# LM_STUDIO_API_BASE=http://localhost:1234/v1
# LM_STUDIO_API_KEY=
